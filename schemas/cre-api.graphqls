  success: Boolean!
}

type Organization {
  organizationId: OrganizationId!
  displayName: LabelText!
  createdAt: Time!
  updatedAt: Time!
  restrictionStatus: OrganizationRestrictionStatus!
  activeStatus: EntityActiveStatus!
