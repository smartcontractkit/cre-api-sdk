enum RegistryType {
  ON_CHAIN
  OFF_CHAIN
}

enum SecretsAuthFlow {
  BROWSER
  OWNER_KEY_SIGNING
}

type Registry {
  id: String!
  label: String!
  type: RegistryType!
  chainSelector: ChainSelector
  address: OnchainAddress
  secretsAuthFlows: [SecretsAuthFlow!]!
}

type Forwarder {
  chainSelector: ChainSelector!
  address: OnchainAddress!
}

"""
On-chain contract reference (address + chain selector).
"""
type OnChainContract {
  chainSelector: ChainSelector!
  address: OnchainAddress!
}

"""
Tenant configuration for CLI context.
"""
type TenantConfig {
  tenantId: TenantId!
  """
  Default DON family for this tenant. Overridable by CLI.
  """
  defaultDonFamily: String!
  """
  Vault DON gateway URL for secrets management.
  """
  vaultGatewayUrl: String!
  """
  CapabilitiesRegistry contract for this tenant.
  """
  capabilitiesRegistry: OnChainContract!
  registries: [Registry!]!
  forwarders: [Forwarder!]!
}

"""
RBAC definition to indicate supported roles & permissions
"""
type PermissionDefinition {
  name: String!
  description: String!
  enableInApiKey: Boolean!
  group: String!
}

type RoleDefinition {
  roleId: String!
  displayName: String!
  description: String!
  permissions: [String!]!
}

type RequiredMetadataDefinition {
  key: String!
  values: [String!]!
}

type ProductRBACDefinition {
  displayName: String!
  productId: String!
  permissions: [PermissionDefinition!]!
  roles: [RoleDefinition!]!
  requiredMetadata: [RequiredMetadataDefinition!]
  suggestedRoleId: String
}

enum KeyLinkStatus {
  KEY_LINK_STATUS_UNSPECIFIED
  KEY_LINK_STATUS_PENDING
  KEY_LINK_STATUS_VERIFIED
  KEY_LINK_STATUS_REVOKED
}

enum ProofPurpose {
  PROOF_PURPOSE_UNSPECIFIED
  PROOF_PURPOSE_LINK
  PROOF_PURPOSE_UNLINK
}

enum ProofStatus {
  PROOF_STATUS_UNSPECIFIED
  PROOF_STATUS_PENDING
  PROOF_STATUS_SUCCESSFUL
  PROOF_STATUS_EXPIRED
  PROOF_STATUS_CANCELLED
}

"""
A key linked to an organization via the Address Registry.
"""
type OrganizationKey {
  organizationId: OrganizationId!
  keyAddress: OnchainAddress!
  chainSelector: ChainSelector
  status: KeyLinkStatus!
  displayName: LabelText!
  createdBy: String!
  verifiedAt: Time!
  revokedAt: Time
  createdAt: Time!
}

"""
Proof of key ownership for an organization key.
"""
type KeyOwnershipProof {
  proofId: String!
  proofHash: String
  challengeNonce: String!
  challengeExpiresAt: Time
  proofType: String!
  proofStatus: ProofStatus!
  proofPurpose: ProofPurpose!
  verifiedAt: Time
}

input InitiateOrganizationKeyLinkRequest {
  keyAddress: OnchainAddress!
  chainSelector: ChainSelector
  displayName: LabelText @length(min: 1, max: 100)
}

input CompleteOrganizationKeyLinkRequest {
  keyAddress: OnchainAddress!
  chainSelector: ChainSelector
  signature: String! @length(min: 1, max: 10000)
}

input InitiateOrganizationKeyUnlinkRequest {
  keyAddress: OnchainAddress!
  chainSelector: ChainSelector
}

input CompleteOrganizationKeyUnlinkRequest {
  keyAddress: OnchainAddress!
  chainSelector: ChainSelector
  signature: String! @length(min: 1, max: 10000)
}

"""
Response from initiating an organization key link.
"""
type InitiateOrganizationKeyLinkResponse {
  proofId: String!
  typedDataJson: JSON!
  nonce: String!
  expiresAt: Time!
}

"""
Response from completing an organization key link.
"""
type CompleteOrganizationKeyLinkResponse {
  key: OrganizationKey!
}

"""
Response from initiating an organization key unlink.
"""
type InitiateOrganizationKeyUnlinkResponse {
  proofId: String!
  typedDataJson: JSON!
  nonce: String!
  expiresAt: Time!
}

"""
Response from completing an organization key unlink.
"""
type CompleteOrganizationKeyUnlinkResponse {
  key: OrganizationKey!
}

"""
Paginated response of organization keys.
"""
type ListOrganizationKeysResponse {
  keys: [OrganizationKey!]!
  nextCursor: Cursor
}

"""
Response containing the active organization key and its ownership proof.
"""
type GetActiveKeyProofResponse {
  key: OrganizationKey!
  proof: KeyOwnershipProof!
}
