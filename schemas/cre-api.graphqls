type Header {
  key: String!
  value: String!
}

input GeneratePresignedPostUrlRequest {
  workflowId: String! @length(min: 1, max: 255)
  artifactType: ArtifactType!
  contentHash: String! @length(min: 1, max: 1000)
  workflowOwnerAddress: OnchainAddress!
  workflowRegistryAddress: OnchainAddress
    @deprecated(reason: "No longer used, omit this field.")
  chainSelector: ChainSelector
    @deprecated(reason: "No longer used, omit this field.")
}

input GeneratePresignedGetUrlRequest {
  workflowId: String! @length(min: 1, max: 255)
  artifactType: ArtifactType!
  workflowRegistryAddress: OnchainAddress!
  chainSelector: ChainSelector!
}

input GenerateUnsignedGetUrlRequest {
  workflowId: String! @length(min: 1, max: 255)
  artifactType: ArtifactType!
  workflowRegistryAddress: OnchainAddress
    @deprecated(reason: "No longer used, omit this field.")
  chainSelector: ChainSelector
    @deprecated(reason: "No longer used, omit this field.")
}

type GeneratePresignedPostUrlResponse {
  presignedPostUrl: String!
  presignedPostFields: [Header!]!
}

type GeneratePresignedGetUrlResponse {
  presignedGetUrl: String!
}

type GenerateUnsignedGetUrlResponse {
  unsignedGetUrl: String!
}

input UserEventInput {
  cliVersion: String @length(min: 1, max: 100)
  exitCode: Int
  errorMessage: String @length(max: 1000)
  actor: ActorInfoInput
  workflow: WorkflowInfoInput
