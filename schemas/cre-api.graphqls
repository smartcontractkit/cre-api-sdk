}

type UpdateOrganizationDetailsResponse {
  success: Boolean!
}

type InviteOrganizationMembersResponse {
  success: Boolean!
}

type RemoveOrganizationMembersResponse {
  success: Boolean!
}

type OrganizationApiKeyDetails {
  apiKeyId: ID!
  organizationId: OrganizationId!
  userId: UserId
  displayName: LabelText
  createdAt: Time!
  updatedAt: Time!
  expiresAt: Time!
  generatedAt: Time!
  activeStatus: EntityActiveStatus!
}

type VerifyApiKeyResponse {
  verificationStatus: ApiKeyVerificationStatus!
  apiKeyDetails: OrganizationApiKeyDetails
  metadata: JSONObject
}

type CreateApiKeyResponse {
  apiKeyId: ID!
  apiKeyToken: CredentialText!
}

type UpdateApiKeyResponse {
  success: Boolean!
}

type RevokeApiKeyResponse {
  success: Boolean!
}

type RotateApiKeyResponse {
  apiKeyToken: CredentialText!
}

input VaultAuthorizationUrlRequest {
  codeChallenge: CredentialText! @length(min: 1, max: 255)
  redirectUri: String! @length(min: 1, max: 255)
  requestDigest: String! @length(min: 1, max: 255)
  workflowOwnerAddress: OnchainAddress
  permission: VaultPermission!
}

type VaultAuthorizationUrlResponse {
  url: String!
}

input AuthCodeTokenExchangeRequest {
  code: CredentialText! @length(min: 1, max: 255)
  codeVerifier: CredentialText! @length(min: 1, max: 255)
  redirectUri: String! @length(min: 1, max: 255)
}

type AuthCodeTokenExchangeResponse {
  accessToken: CredentialText!
