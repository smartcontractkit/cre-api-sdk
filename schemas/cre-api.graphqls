  command: CommandInfoInput
  attributes: [KeyValue!] @length(max: 50)
}

input ActorInfoInput {
  userId: String @length(min: 1, max: 255)
  organizationId: String @length(min: 1, max: 255)
  machineId: String @length(min: 1, max: 255)
}

input WorkflowInfoInput {
  ownerAddress: String @length(max: 255)
  name: String @length(max: 255)
  id: String @length(max: 255)
  language: String @length(max: 50)
}

input MachineInfoInput {
  osName: String @length(min: 1, max: 100)
  osVersion: String @length(min: 1, max: 100)
  architecture: String @length(min: 1, max: 50)
}

input CommandInfoInput {
  action: String @length(min: 1, max: 100)
  subcommand: String @length(max: 100)
  args: [String!] @length(max: 20)
  flags: [KeyValue!] @length(max: 50)
}

type ReportUserEventResponse {
  success: Boolean!
  message: String
}

input RequestDeploymentAccessInput {
  description: String! @length(min: 1, max: 1000)
  workflowUrl: String @length(min: 1, max: 1000)
}

type RequestDeploymentAccessResponse {
  success: Boolean!
  message: String
}

input RequestHelpInput {
  issueType: SupportTicketRequestType!
  product: SupportTicketProduct!
  description: String! @length(min: 1, max: 1000)
}

type RequestHelpResponse {
  success: Boolean!
  message: String
}

enum RegistryType {
  ON_CHAIN
  OFF_CHAIN
}

enum SecretsAuthFlow {
  BROWSER
  OWNER_KEY_SIGNING
}

type Registry {
  id: String!
  label: String!
  type: RegistryType!
  chainSelector: ChainSelector
  address: OnchainAddress
  secretsAuthFlows: [SecretsAuthFlow!]!
}

type Forwarder {
  chainSelector: ChainSelector!
  address: OnchainAddress!
}

"""
On-chain contract reference (address + chain selector).
"""
type OnChainContract {
  chainSelector: ChainSelector!
  address: OnchainAddress!
}

"""
Tenant configuration for CLI context.
"""
type TenantConfig {
  tenantId: TenantId!
  """
  Default DON family for this tenant. Overridable by CLI.
  """
  defaultDonFamily: String!
  """
  Vault DON gateway URL for secrets management.
  """
  vaultGatewayUrl: String!
  """
  CapabilitiesRegistry contract for this tenant.
  """
  capabilitiesRegistry: OnChainContract!
  registries: [Registry!]!
  forwarders: [Forwarder!]!
}
