schema {
  query: Query
  mutation: Mutation
}

scalar Time

scalar ChainSelector

scalar OnchainAddress

scalar CredentialText

scalar UUID

scalar LabelText

scalar Email

scalar UserId

scalar MemberId

scalar OrganizationId

scalar TenantId

scalar WorkflowId

scalar CreditAmount

scalar JSONObject

scalar ResourceTypeWithGas

"""
Directive to verify that the caller is authenticated.

Should be used for calls that do not use the auth context, but should still
guard endpoints from unauthenticated calls.
"""
directive @isAuthenticated on FIELD_DEFINITION

"""
Directive to restrict an endpoint to be accessible only with the specific permission.

"perm1" OR "perm2" can be achieved by a single directive, by specifying multiple values.
"perm1" AND "perm2" can be achieved by defining multiple instances of this directive.
"""
directive @hasAnyPermission(
  permissions: [String!]!
) repeatable on FIELD_DEFINITION

"""
Directive to restrict an endpoint to be accessible only by the specific roles.

"role1" OR "role2" can be achieved by a single directive, by specifying multiple values.
"role1" AND "role2" can be achieved by defining multiple instances of this directive.

Note that this automatically excludes API keys from being able to call endpoints - since roles only apply to user context.
Typically, @hasAnyPermission should be used instead.

TODO: this can be deprecated to limit complexity. After RBAC is fully implemented - @hasAnyPermission can be used instead
for all endpoints, which will enable usage for both API keys and roles.
"""
directive @hasAnyRole(roleIds: [String!]!) repeatable on FIELD_DEFINITION

"""
Directive to verify that the caller's organization is not gated.

Should be used for calls that should only be open to accounts that have full closed beta access.
"""
directive @isUngatedOrganization on FIELD_DEFINITION

"""
Directive to verify that the caller's organization matches the values specified in the claim.

Should be used for calls that need to be gated by claims.
"""
directive @hasClaim(claimName: String!, values: [String!]) on FIELD_DEFINITION

directive @length(
  min: Int
  max: Int
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

directive @size(
  min: Int
  max: Int
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

type Query {
  """
  Account details
  """
  getAccountDetails: OrganizationAccount
  """
  Organization details
  """
  getOrganization: Organization
  listOrganizationMembers(
    memberFilters: OrganizationMemberFilters
  ): [OrganizationAccount!]!
  """
  API keys
  """
  verifyApiKey(
    apiKeyToken: CredentialText! @length(min: 1, max: 255)
  ): VerifyApiKeyResponse!
  listApiKeys(
    apiKeyFilters: OrganizationApiKeyFilters!
  ): [OrganizationApiKeyDetails!]!
  """
  Workflow owners
  """
  listWorkflowOwners(
    filters: WorkflowOwnersFilters
  ): ListWorkflowOwnersResponse!
  """
  Workflows
  """
  workflowActivity(input: WorkflowActivityInput!): WorkflowActivityOutput!
  workflow(input: WorkflowInput!): WorkflowOutput!
  workflows(input: WorkflowsInput!): WorkflowsOutput!
  workflowDeployments(
    input: WorkflowDeploymentsInput!
  ): WorkflowDeploymentsOutput!
  workflowDeployment(input: WorkflowDeploymentInput!): WorkflowDeploymentOutput!
  workflowExecutions(input: WorkflowExecutionsInput!): WorkflowExecutionsOutput!
  workflowExecution(input: WorkflowExecutionInput!): WorkflowExecutionOutput!
  workflowExecutionLogs(
    input: WorkflowExecutionLogsInput!
  ): WorkflowExecutionLogsOutput!
  workflowExecutionEvents(
    input: WorkflowExecutionEventsInput!
  ): WorkflowExecutionEventsOutput!
  """
  Tenant configuration for the authenticated user.
  Returns available registries and deployment context.
  """
  getTenantConfig: TenantConfig! @isAuthenticated
  """
  Billing
  """
  getWorkflowResourceConsumption(
    filters: GetWorkflowResourceConsumptionFilters!
    page: Page!
  ): [WorkflowResourceConsumption]! @isAuthenticated
  getAggregatedWorkflowResourceConsumption(
    filters: GetAggregatedWorkflowResourceConsumptionFilters!
  ): [AggregatedWorkflowResourceConsumption]! @isAuthenticated
  getOffchainWorkflowById(
    request: GetOffchainWorkflowByIdRequest!
  ): GetOffchainWorkflowByIdResponse! @isUngatedOrganization
  getOffchainWorkflowByOwnerAndName(
    request: GetOffchainWorkflowByOwnerAndNameRequest!
  ): GetOffchainWorkflowByOwnerAndNameResponse! @isUngatedOrganization
  getOffchainWorkflowByName(
    request: GetOffchainWorkflowByNameRequest!
  ): GetOffchainWorkflowByNameResponse! @isUngatedOrganization
  listOffchainWorkflows(
    request: ListOffchainWorkflowsRequest!
  ): ListOffchainWorkflowsResponse! @isUngatedOrganization
}

type Mutation {
  updateAccountDetails(
    displayName: LabelText! @length(min: 1, max: 100)
  ): UpdateAccountDetailsResponse!
  updateOrganizationDetails(
    displayName: LabelText! @length(min: 1, max: 100)
  ): UpdateOrganizationDetailsResponse!
  inviteOrganizationMembers(
    members: [OrganizationAccountInviteParams!]! @length(min: 1, max: 10)
  ): InviteOrganizationMembersResponse! @hasAnyRole(roleIds: ["platform:root"])
  removeOrganizationMembers(
    memberIds: [MemberId!]! @length(min: 1, max: 10)
  ): RemoveOrganizationMembersResponse! @hasAnyRole(roleIds: ["platform:root"])
  createApiKey(request: CreateApiKeyRequest!): CreateApiKeyResponse!
    @isUngatedOrganization
  updateApiKey(request: UpdateApiKeyRequest!): UpdateApiKeyResponse!
    @isUngatedOrganization
  revokeApiKey(
    apiKeyId: CredentialText! @length(min: 1, max: 255)
  ): RevokeApiKeyResponse!
  rotateApiKey(request: RotateApiKeyRequest!): RotateApiKeyResponse!
    @isUngatedOrganization
  createVaultAuthorizationUrl(
    request: VaultAuthorizationUrlRequest!
  ): VaultAuthorizationUrlResponse!
    @isUngatedOrganization
    @hasClaim(
      claimName: "claim_vault_secret_management_enabled"
      values: ["true"]
    )
  exchangeAuthCodeToToken(
    request: AuthCodeTokenExchangeRequest!
  ): AuthCodeTokenExchangeResponse! @isUngatedOrganization
  updateLinkedOwnerMetadata(
    request: UpdateOwnerMetadataRequest!
  ): UpdateOwnerMetadataResponse! @isUngatedOrganization
  initiateLinking(request: InitiateLinkingRequest!): InitiateLinkingResponse!
    @isUngatedOrganization
  initiateUnlinking(
    request: InitiateUnlinkingRequest!
  ): InitiateUnlinkingResponse!
  upsertOffchainWorkflow(
    request: UpsertOffchainWorkflowRequest!
  ): UpsertOffchainWorkflowResponse! @isUngatedOrganization
  pauseOffchainWorkflow(
    request: PauseOffchainWorkflowRequest!
  ): PauseOffchainWorkflowResponse! @isUngatedOrganization
  activateOffchainWorkflow(
    request: ActivateOffchainWorkflowRequest!
  ): ActivateOffchainWorkflowResponse! @isUngatedOrganization
  deleteOffchainWorkflow(
    request: DeleteOffchainWorkflowRequest!
  ): DeleteOffchainWorkflowResponse! @isUngatedOrganization
  """
  Generate a presigned POST URL for uploading artifacts
  for a workflow.
  """
  generatePresignedPostUrlForArtifact(
    artifact: GeneratePresignedPostUrlRequest!
  ): GeneratePresignedPostUrlResponse! @isUngatedOrganization
  """
  Generate a presigned GET URL for downloading artifacts
  for a workflow.
  """
  generatePresignedGetUrlForArtifact(
    artifact: GeneratePresignedGetUrlRequest!
  ): GeneratePresignedGetUrlResponse! @isUngatedOrganization
  """
  Generate an unsigned GET URL for referencing artifacts
  for a workflow.
  """
  generateUnsignedGetUrlForArtifact(
    artifact: GenerateUnsignedGetUrlRequest!
  ): GenerateUnsignedGetUrlResponse! @isUngatedOrganization
  reportUserEvent(event: UserEventInput!): ReportUserEventResponse!
  requestDeploymentAccess(
    input: RequestDeploymentAccessInput!
  ): RequestDeploymentAccessResponse! @isAuthenticated
  requestHelp(input: RequestHelpInput!): RequestHelpResponse! @isAuthenticated
}

input KeyValue {
  key: String! @length(min: 1, max: 1000)
  value: String! @length(min: 1, max: 1000)
}

enum MemberStatus {
  INVITED
  JOINED
  REMOVED
}

enum MemberType {
  ROOT
  ADMIN
}

enum OrganizationRestrictionStatus {
  GATED
  FULL_ACCESS
}

enum EntityActiveStatus {
  ACTIVE
  DELETED
}

enum ApiKeyVerificationStatus {
  VALID
  INVALID
  EXPIRED
}

enum OrganizationApiKeyScope {
  USER_KEYS
  ORG_KEYS
}

enum LinkStatusFilter {
  LINKED_ONLY
  UNLINKED_ONLY
}

enum Environment {
  PRODUCTION_MAINNET
  PRODUCTION_TESTNET
}

enum LinkRequestProcess {
  EOA
  MSIG
}

enum OwnershipVerificationStatus {
  VERIFICATION_PENDING
  VERIFICATION_SUCCESSFULL
  VERIFICATION_EXPIRED
  VERIFICATION_FAILED
}

enum ArtifactType {
  BINARY
  CONFIG
}

enum SortingOrder {
  ASC
  DESC
}

enum WorkflowDeploymentStatus {
  PENDING
  FAILED
  ACTIVE
  PAUSED
  DELETED
}

enum WorkflowExecutionStatus {
  UNKNOWN
  UNSPECIFIED
  TRIGGERED
  IN_PROGRESS
  SUCCESS
  FAILURE
}

enum WorkflowExecutionClassifiedStatus {
  UNSPECIFIED
  SUCCESS
  USER_ERROR
  SYSTEM_ERROR
}

enum MeasurementUnit {
  MEASUREMENT_UNIT_UNSPECIFIED
  MEASUREMENT_UNIT_BYTES
  MEASUREMENT_UNIT_MILLISECONDS
  MEASUREMENT_UNIT_OPERATIONS
  MEASUREMENT_UNIT_COST
}

enum ResourceConsumptionGroupDimension {
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_UNSPECIFIED
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_WORKFLOW_ID
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_NETWORK
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_DAY
}

enum SupportTicketRequestType {
  cre_general_feedback
  cre_feature_request
  cre_bug_report
  cre_support_request
  cre_customer_deploy_access_request
  cre_other
}

enum SupportTicketProduct {
  ACE
  CRE
  STREAMS
  CREC
}

enum VaultPermission {
  VAULT_PERMISSION_CREATE_SECRETS
  VAULT_PERMISSION_DELETE_SECRETS
  VAULT_PERMISSION_UPDATE_SECRETS
  VAULT_PERMISSION_LIST_SECRETS
}

type OrganizationAccount {
