  organizationId: OrganizationId!
  emailAddress: Email!
  displayName: LabelText!
  memberType: MemberType
  memberStatus: MemberStatus!
  createdAt: Time!
  updatedAt: Time!
  invitedByUser: UserId
  invitedAt: Time
  joinedAt: Time
  removedByUser: UserId
  removedAt: Time
}

