schema {
  query: Query
  mutation: Mutation
}

scalar Time

scalar ChainSelector

scalar OnchainAddress

scalar CredentialText

scalar UUID

scalar LabelText

scalar Email

scalar UserId

scalar MemberId

scalar RoleId

scalar OrganizationId

scalar TenantId

scalar WorkflowId

scalar Cursor

scalar CreditAmount

scalar JSONObject

scalar JSON

scalar ResourceTypeWithGas

"""
Directive to verify that the caller is authenticated.

Should be used for calls that do not use the auth context, but should still
guard endpoints from unauthenticated calls.
"""
directive @isAuthenticated on FIELD_DEFINITION

"""
Directive to restrict an endpoint to be accessible only with the specific permission.

"perm1" OR "perm2" can be achieved by a single directive, by specifying multiple values.
"perm1" AND "perm2" can be achieved by defining multiple instances of this directive.
"""
directive @hasAnyPermission(
  permissions: [String!]!
  allowScoped: Boolean
) repeatable on FIELD_DEFINITION

"""
Directive to verify that the caller's organization is not gated.

Should be used for calls that should only be open to accounts that have full closed beta access.
"""
directive @isUngatedOrganization on FIELD_DEFINITION

"""
Directive to verify that the caller's organization matches the values specified in the claim.

Should be used for calls that need to be gated by claims.
"""
directive @hasClaim(claimName: String!, values: [String!]) on FIELD_DEFINITION

"""
Validates the length of a string, or the number of entries in a list/map.

- On a `String`, it constrains the number of characters (Unicode code points).
- On a list/map, it constrains the number of elements.

This directive measures the value it is applied to. To constrain the length of
the elements *inside* a list, use `@nestedLength`. The two are complementary
and can be combined to bound both the collection size and the element size:

    [String] @length(min: 1, max: 10) @nestedLength(max: 100)
"""
directive @length(
  min: Int
  max: Int
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

"""
Validates the numeric value of an `Int` against the provided bounds. This is a
range check on the value itself, not a length check.

Use `@length` for strings and collections, and `@nestedLength` for the elements
contained in a collection.
"""
directive @size(
  min: Int
  max: Int
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

"""
Recursively validates the length of every string contained in a list.

Unlike `@length`, which measures the collection itself, `@nestedLength`
descends into (possibly nested) lists and applies the length bounds to each
leaf string, counted in characters (Unicode code points). Only lists of strings
(or string-backed scalars and enums) are supported. For example:

    [String] @length(min: 1, max: 10) @nestedLength(max: 100)

requires the list to contain between 1 and 10 elements and every string to be
at most 100 characters long.
"""
directive @nestedLength(
  min: Int
  max: Int
) on INPUT_FIELD_DEFINITION | ARGUMENT_DEFINITION

type Query {
  """
  Account details
  """
  getAccountDetails: OrganizationAccount
  """
  Organization details
  """
  getOrganization: Organization
    @hasAnyPermission(permissions: ["platform:organization:read"])
  listOrganizationMembers(
    memberFilters: OrganizationMemberFilters
  ): [OrganizationAccount!]!
    @hasAnyPermission(permissions: ["platform:member:read"])
  """
  API keys
  """
  verifyApiKey(
    apiKeyToken: CredentialText! @length(min: 1, max: 255)
  ): VerifyApiKeyResponse!
  listApiKeys(
    apiKeyFilters: OrganizationApiKeyFilters!
  ): [OrganizationApiKeyDetails!]!
    @hasAnyPermission(permissions: ["platform:api_key:read"])
  """
  RBAC definitions
  """
  getRBACDefinition: [ProductRBACDefinition!]! @isAuthenticated
  """
  Organization limits
  """
  listActiveOrganizationLimits(
    limitFilters: OrganizationLimitFilters
  ): [OrganizationLimit!]!
    @hasAnyPermission(permissions: ["platform:limits:read"], allowScoped: true)
  """
  Workflow owners
  """
  listWorkflowOwners(
    filters: WorkflowOwnersFilters
  ): ListWorkflowOwnersResponse!
    @hasAnyPermission(permissions: ["platform:owner_address:read"])
  """
  Workflows
  """
  workflowActivity(input: WorkflowActivityInput!): WorkflowActivityOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflow(input: WorkflowInput!): WorkflowOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflows(input: WorkflowsInput!): WorkflowsOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowDeployments(
    input: WorkflowDeploymentsInput!
  ): WorkflowDeploymentsOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowDeployment(
    input: WorkflowDeploymentInput!
  ): WorkflowDeploymentOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowExecutions(
    input: WorkflowExecutionsInput!
  ): WorkflowExecutionsOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowExecution(input: WorkflowExecutionInput!): WorkflowExecutionOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowExecutionLogs(
    input: WorkflowExecutionLogsInput!
  ): WorkflowExecutionLogsOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  workflowExecutionEvents(
    input: WorkflowExecutionEventsInput!
  ): WorkflowExecutionEventsOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  """
  Looks up the parent workflow of a deployment by the deployment's hex workflow ID.
  Returns basic workflow data only, without stats or enrichment.
  """
  workflowByDeploymentId(
    input: WorkflowByDeploymentIdInput!
  ): WorkflowByDeploymentIdOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  """
  Looks up a workflow deployment by its hex workflow ID.
  Returns basic deployment data only, without stats or enrichment.
  """
  workflowDeploymentById(
    input: WorkflowDeploymentByIdInput!
  ): WorkflowDeploymentByIdOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  """
  Looks up a workflow execution by its hex execution ID.
  Returns basic execution data only, without stats or enrichment.
  """
  workflowExecutionById(
    input: WorkflowExecutionByIdInput!
  ): WorkflowExecutionByIdOutput!
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  """
  Tenant configuration for the authenticated user.
  Returns available registries and deployment context.
  """
  getTenantConfig: TenantConfig! @isAuthenticated
  """
  Billing
  """
  getWorkflowResourceConsumption(
    filters: GetWorkflowResourceConsumptionFilters!
    page: Page!
  ): [WorkflowResourceConsumption]!
    @isAuthenticated
    @hasAnyPermission(permissions: ["platform:billing:read"], allowScoped: true)
  getAggregatedWorkflowResourceConsumption(
    filters: GetAggregatedWorkflowResourceConsumptionFilters!
  ): [AggregatedWorkflowResourceConsumption]!
    @isAuthenticated
    @hasAnyPermission(permissions: ["platform:billing:read"], allowScoped: true)
  getOffchainWorkflowById(
    request: GetOffchainWorkflowByIdRequest!
  ): GetOffchainWorkflowByIdResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  getOffchainWorkflowByOwnerAndName(
    request: GetOffchainWorkflowByOwnerAndNameRequest!
  ): GetOffchainWorkflowByOwnerAndNameResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  getOffchainWorkflowByName(
    request: GetOffchainWorkflowByNameRequest!
  ): GetOffchainWorkflowByNameResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  listOffchainWorkflows(
    request: ListOffchainWorkflowsRequest!
  ): ListOffchainWorkflowsResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:read"])
  """
  Organization keys registered with the Address Registry.
  """
  organizationKeys(page: Page): ListOrganizationKeysResponse!
    @hasAnyPermission(permissions: ["platform:owner_address:read"])
  """
  Active key and ownership proof for a given key address.
  """
  getActiveKeyProof(
    keyAddress: OnchainAddress!
    chainSelector: ChainSelector
  ): GetActiveKeyProofResponse!
    @hasAnyPermission(permissions: ["platform:owner_address:read"])
}

type Mutation {
  updateAccountDetails(
    displayName: LabelText! @length(min: 1, max: 100)
  ): UpdateAccountDetailsResponse!
  updateOrganizationDetails(
    displayName: LabelText @length(min: 1, max: 100)
  ): UpdateOrganizationDetailsResponse!
    @hasAnyPermission(permissions: ["platform:organization:write"])
  inviteOrganizationMembers(
    members: [OrganizationAccountInviteParams!]! @length(min: 1, max: 10)
  ): InviteOrganizationMembersResponse!
    @hasAnyPermission(permissions: ["platform:member_invite:write"])
  removeOrganizationMembers(
    memberIds: [MemberId!]! @length(min: 1, max: 10)
  ): RemoveOrganizationMembersResponse!
    @hasAnyPermission(permissions: ["platform:member:write"])
  createApiKey(request: CreateApiKeyRequest!): CreateApiKeyResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["platform:api_key:write"])
  updateApiKey(request: UpdateApiKeyRequest!): UpdateApiKeyResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["platform:api_key:write"])
  revokeApiKey(
    apiKeyId: CredentialText! @length(min: 1, max: 255)
  ): RevokeApiKeyResponse!
    @hasAnyPermission(permissions: ["platform:api_key:write"])
  rotateApiKey(request: RotateApiKeyRequest!): RotateApiKeyResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["platform:api_key:write"])
  updateMemberRoles(
    request: UpdateMemberRolesRequest!
  ): UpdateMemberRolesResponse!
    @hasAnyPermission(
      permissions: ["platform:member_role:write"]
      allowScoped: true
    )
  createVaultAuthorizationUrl(
    request: VaultAuthorizationUrlRequest!
  ): VaultAuthorizationUrlResponse!
    @isUngatedOrganization
    @hasClaim(
      claimName: "claim_vault_secret_management_enabled"
      values: ["true"]
    )
    @hasAnyPermission(permissions: ["cre:secret:read", "cre:secret:write"])
  exchangeAuthCodeToToken(
    request: AuthCodeTokenExchangeRequest!
  ): AuthCodeTokenExchangeResponse! @isUngatedOrganization
  upsertOrganizationLimit(
    input: UpsertOrganizationLimitInput!
  ): UpsertOrganizationLimitResponse!
    @hasAnyPermission(permissions: ["platform:limits:write"], allowScoped: true)
  deleteOrganizationLimit(
    input: DeleteOrganizationLimitInput!
  ): DeleteOrganizationLimitResponse!
    @hasAnyPermission(permissions: ["platform:limits:write"], allowScoped: true)
  updateLinkedOwnerMetadata(
    request: UpdateOwnerMetadataRequest!
  ): UpdateOwnerMetadataResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["platform:owner_address:linking:write/cre"])
  initiateLinking(request: InitiateLinkingRequest!): InitiateLinkingResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["platform:owner_address:linking:write/cre"])
  initiateUnlinking(
    request: InitiateUnlinkingRequest!
  ): InitiateUnlinkingResponse!
    @hasAnyPermission(permissions: ["platform:owner_address:linking:write/cre"])
  initiateOrganizationKeyLink(
    request: InitiateOrganizationKeyLinkRequest!
  ): InitiateOrganizationKeyLinkResponse!
    @hasAnyPermission(
      permissions: ["platform:owner_address:linking:write"]
      allowScoped: true
    )
  completeOrganizationKeyLink(
    request: CompleteOrganizationKeyLinkRequest!
  ): CompleteOrganizationKeyLinkResponse!
    @hasAnyPermission(
      permissions: ["platform:owner_address:linking:write"]
      allowScoped: true
    )
  initiateOrganizationKeyUnlink(
    request: InitiateOrganizationKeyUnlinkRequest!
  ): InitiateOrganizationKeyUnlinkResponse!
    @hasAnyPermission(
      permissions: ["platform:owner_address:linking:write"]
      allowScoped: true
    )
  completeOrganizationKeyUnlink(
    request: CompleteOrganizationKeyUnlinkRequest!
  ): CompleteOrganizationKeyUnlinkResponse!
    @hasAnyPermission(
      permissions: ["platform:owner_address:linking:write"]
      allowScoped: true
    )
  upsertOffchainWorkflow(
    request: UpsertOffchainWorkflowRequest!
  ): UpsertOffchainWorkflowResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:write/private_registry"])
  pauseOffchainWorkflow(
    request: PauseOffchainWorkflowRequest!
  ): PauseOffchainWorkflowResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:write/private_registry"])
  activateOffchainWorkflow(
    request: ActivateOffchainWorkflowRequest!
  ): ActivateOffchainWorkflowResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:write/private_registry"])
  deleteOffchainWorkflow(
    request: DeleteOffchainWorkflowRequest!
  ): DeleteOffchainWorkflowResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:write/private_registry"])
  """
  Generate a presigned POST URL for uploading artifacts
  for a workflow.
  """
  generatePresignedPostUrlForArtifact(
    artifact: GeneratePresignedPostUrlRequest!
  ): GeneratePresignedPostUrlResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:artifact:write"])
  """
  Generate a presigned GET URL for downloading artifacts
  for a workflow.
  """
  generatePresignedGetUrlForArtifact(
    artifact: GeneratePresignedGetUrlRequest!
  ): GeneratePresignedGetUrlResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:artifact:read"])
  """
  Generate an unsigned GET URL for referencing artifacts
  for a workflow.
  """
  generateUnsignedGetUrlForArtifact(
    artifact: GenerateUnsignedGetUrlRequest!
  ): GenerateUnsignedGetUrlResponse!
    @isUngatedOrganization
    @hasAnyPermission(permissions: ["cre:workflow:artifact:read"])
  reportUserEvent(event: UserEventInput!): ReportUserEventResponse!
  requestDeploymentAccess(
    input: RequestDeploymentAccessInput!
  ): RequestDeploymentAccessResponse! @isAuthenticated
  requestHelp(input: RequestHelpInput!): RequestHelpResponse! @isAuthenticated
}

input KeyValue {
  key: String! @length(min: 1, max: 1000)
  value: String! @length(min: 1, max: 1000)
}

enum MemberStatus {
  INVITED
  JOINED
  REMOVED
  INVITE_EXPIRED
}

enum MemberType {
  ROOT @deprecated(reason: "Use memberRoleIds instead")
  ADMIN @deprecated(reason: "Use memberRoleIds instead")
}

enum OrganizationRestrictionStatus {
  GATED
  FULL_ACCESS
}

enum EntityActiveStatus {
  ACTIVE
  DELETED
}

enum ApiKeyVerificationStatus {
  VALID
  INVALID
  EXPIRED
}

enum OrganizationApiKeyScope {
  USER_KEYS
  ORG_KEYS
}

enum LinkStatusFilter {
  LINKED_ONLY
  UNLINKED_ONLY
}

enum Environment {
  PRODUCTION_MAINNET
  PRODUCTION_TESTNET
}

enum LinkRequestProcess {
  EOA
  MSIG
}

enum OwnershipVerificationStatus {
  VERIFICATION_PENDING
  VERIFICATION_SUCCESSFULL
  VERIFICATION_EXPIRED
  VERIFICATION_FAILED
}

enum ArtifactType {
  BINARY
  CONFIG
}

enum SortingOrder {
  ASC
  DESC
}

enum WorkflowDeploymentStatus {
  PENDING
  FAILED
  ACTIVE
  PAUSED
  DELETED
}

enum WorkflowExecutionStatus {
  UNKNOWN
  UNSPECIFIED
  TRIGGERED
  IN_PROGRESS
  SUCCESS
  FAILURE
}

enum WorkflowExecutionClassifiedStatus {
  UNSPECIFIED
  SUCCESS
  USER_ERROR
  SYSTEM_ERROR
}

"""
Refines WorkflowExecutionStatus with whether the execution carried any error detail, so a clean
success can be told apart from one that errored, and a failure that explains itself from one that
does not.

Can be null, fall back to status in that case rather than rendering it as a distinct state.
"""
enum WorkflowExecutionDetailedStatus {
  UNSPECIFIED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  FAILED_NO_DETAIL
}

enum MeasurementUnit {
  MEASUREMENT_UNIT_UNSPECIFIED
  MEASUREMENT_UNIT_BYTES
  MEASUREMENT_UNIT_MILLISECONDS
  MEASUREMENT_UNIT_OPERATIONS
  MEASUREMENT_UNIT_COST
}

enum ResourceConsumptionGroupDimension {
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_UNSPECIFIED
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_WORKFLOW_ID
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_NETWORK
  RESOURCE_CONSUMPTION_GROUP_DIMENSION_DAY
}

enum SupportTicketRequestType {
  cre_general_feedback
  cre_feature_request
  cre_bug_report
  cre_support_request
  cre_customer_deploy_access_request
  cre_other
}

enum SupportTicketProduct {
  ACE
  CRE
  STREAMS
  CREC
}

enum VaultPermission {
  VAULT_PERMISSION_CREATE_SECRETS
  VAULT_PERMISSION_DELETE_SECRETS
  VAULT_PERMISSION_UPDATE_SECRETS
  VAULT_PERMISSION_LIST_SECRETS
}

type OrganizationAccount {
  memberId: MemberId!
  userId: UserId
  organizationId: OrganizationId!
  emailAddress: Email!
  displayName: LabelText!
  memberType: MemberType @deprecated(reason: "Use memberRoleIds instead")
  memberStatus: MemberStatus!
  createdAt: Time!
  updatedAt: Time!
  invitedByUser: UserId
  invitedAt: Time
  joinedAt: Time
  removedByUser: UserId
  removedAt: Time
  memberRoleIds: [RoleId!]!
}

type UpdateAccountDetailsResponse {
  success: Boolean!
}

type Organization {
  organizationId: OrganizationId!
  displayName: LabelText!
  createdAt: Time!
  updatedAt: Time!
  restrictionStatus: OrganizationRestrictionStatus!
  activeStatus: EntityActiveStatus!
  tenantId: Int!
}

type UpdateOrganizationDetailsResponse {
  success: Boolean!
}

type InviteOrganizationMembersResponse {
  success: Boolean!
}

type RemoveOrganizationMembersResponse {
  success: Boolean!
}

type UpdateMemberRolesResponse {
  success: Boolean!
}

type OrganizationApiKeyDetails {
  apiKeyId: ID!
  organizationId: OrganizationId!
  userId: UserId
  displayName: LabelText
  createdAt: Time!
  updatedAt: Time!
  expiresAt: Time!
  generatedAt: Time!
  activeStatus: EntityActiveStatus!
  permissions: [String!]!
  createdByUser: String!
}

type VerifyApiKeyResponse {
  verificationStatus: ApiKeyVerificationStatus!
  apiKeyDetails: OrganizationApiKeyDetails
  metadata: JSONObject
}

type CreateApiKeyResponse {
  apiKeyId: ID!
  apiKeyToken: CredentialText!
}

type UpdateApiKeyResponse {
  success: Boolean!
}

type RevokeApiKeyResponse {
  success: Boolean!
}

type RotateApiKeyResponse {
  apiKeyToken: CredentialText!
}

type OrganizationLimit {
  organizationId: OrganizationId!
  limitKey: String!
  limitValue: JSON!
  version: Int!
  changedBy: String!
  createdAt: Time!
  updatedAt: Time!
  isActive: Boolean!
}

input UpsertOrganizationLimitInput {
  limitKey: String! @length(min: 1, max: 100)
  limitValue: JSON!
}

input DeleteOrganizationLimitInput {
  limitKey: String! @length(min: 1, max: 100)
}

type DeleteOrganizationLimitResponse {
  success: Boolean!
}

type UpsertOrganizationLimitResponse {
  success: Boolean!
  version: Int!
}

input VaultAuthorizationUrlRequest {
  codeChallenge: CredentialText! @length(min: 1, max: 255)
  redirectUri: String! @length(min: 1, max: 255)
  requestDigest: String! @length(min: 1, max: 255)
  workflowOwnerAddress: OnchainAddress
  permission: VaultPermission!
  state: String @length(min: 1, max: 255)
}

type VaultAuthorizationUrlResponse {
  url: String!
}

input AuthCodeTokenExchangeRequest {
  code: CredentialText! @length(min: 1, max: 255)
  codeVerifier: CredentialText! @length(min: 1, max: 255)
  redirectUri: String! @length(min: 1, max: 255)
}

type AuthCodeTokenExchangeResponse {
  accessToken: CredentialText!
  expiresIn: Int!
}

type WorkflowOwner {
  workflowOwnerAddress: OnchainAddress!
  workflowOwnerLabel: String
  environment: Environment!
  verificationStatus: OwnershipVerificationStatus!
  verifiedAt: Time
  chainSelector: ChainSelector!
  contractAddress: OnchainAddress!
  requestProcess: LinkRequestProcess
}

type ListWorkflowOwnersResponse {
  linkedOwners: [WorkflowOwner]
  unlinkedOwners: [WorkflowOwner]
}

type InitiateLinkingResponse {
  ownershipProofHash: String!
  workflowOwnerAddress: OnchainAddress!
  validUntil: Time!
  signature: String!
  chainSelector: ChainSelector!
  contractAddress: OnchainAddress!
  transactionData: String!
  functionSignature: String!
  functionArgs: [String!]!
}

type InitiateUnlinkingResponse {
  ownershipProofHash: String!
  workflowOwnerAddress: OnchainAddress!
  validUntil: Time!
  signature: String!
  chainSelector: ChainSelector!
  contractAddress: OnchainAddress!
  transactionData: String!
  functionSignature: String!
  functionArgs: [String!]!
}

type UpdateOwnerMetadataResponse {
  success: Boolean!
}

type WorkflowActivityRow {
  from: Time!
  to: Time!
  successCount: Int!
  failureCount: Int!
}

input WorkflowActivityInput {
  workflowUUID: String @length(min: 1, max: 255)
  "Start of the activity range. Required."
  from: Time!
  "End of the activity range. Must be after `from`. Required."
  to: Time!
}

type WorkflowActivityOutput {
  data: [WorkflowActivityRow!]
}

input WorkflowInput {
  uuid: String! @length(min: 1, max: 255)
  from: Time!
}

type WorkflowOutput {
  data: Workflow!
}

type Workflow {
  uuid: String!
  ownerAddress: OnchainAddress!
  name: String!
  workflowId: WorkflowId!
  status: WorkflowDeploymentStatus!
  registeredAt: Time!
  creditUsed: CreditAmount
  executedAt: Time
  executionCount: Int!
  executionCountByStatus: WorkflowExecutionCountByStatus!
  workflowSource: String!
  hasTeeExecutions: Boolean!
  hasNonTeeExecutions: Boolean!
}

type WorkflowExecutionCountByStatus {
  success: Int!
  failure: Int!
}

enum WorkflowOrderByField {
  NAME
  STATUS
  EXECUTED_AT
}

input WorkflowOrderBy {
  field: WorkflowOrderByField!
  order: SortingOrder!
}

input WorkflowsInput {
  workflowOwnerAddress: [OnchainAddress!] @length(min: 1, max: 100)
  status: [WorkflowDeploymentStatus!] @length(min: 1, max: 10)
  search: String @length(min: 1, max: 255)
  orderBy: WorkflowOrderBy
  page: Page
}

type WorkflowsOutput {
  data: [Workflow!]!
  count: Int!
}

type WorkflowDeployment {
  uuid: String!
  workflowID: String!
  errorMessage: String
  txHash: String
  binaryURL: String
  configURL: String
  status: WorkflowDeploymentStatus!
  deployedAt: Time!
  executionCountByStatus: WorkflowExecutionCountByStatus
  workflowSource: String!
  hasTeeExecutions: Boolean!
  hasNonTeeExecutions: Boolean!
}

enum WorkflowDeploymentOrderByField {
  WORKFLOW_ID
  DEPLOYED_AT
}

input WorkflowDeploymentOrderBy {
  field: WorkflowDeploymentOrderByField!
  order: SortingOrder!
}

input WorkflowDeploymentsInput {
  workflowUUID: String! @length(min: 1, max: 255)
  status: [WorkflowDeploymentStatus!] @length(min: 1, max: 10)
  from: Time
  to: Time
  search: String @length(min: 1, max: 255)
  orderBy: WorkflowDeploymentOrderBy
  page: Page
}

type WorkflowDeploymentsOutput {
  data: [WorkflowDeployment!]!
  count: Int!
}

input WorkflowDeploymentInput {
  uuid: String! @length(min: 1, max: 255)
}

type WorkflowDeploymentOutput {
  data: WorkflowDeployment!
}

type WorkflowExecution {
  uuid: String!
  workflowUUID: String!
  id: String!
  workflowName: String!
  workflowId: WorkflowId!
  status: WorkflowExecutionStatus!
  startedAt: Time!
  finishedAt: Time
  creditUsed: CreditAmount
  errors: [ExecutionError]
  executedInTee: Boolean
  classifiedStatus: WorkflowExecutionClassifiedStatus
  detailedStatus: WorkflowExecutionDetailedStatus
  """
  Returned when querying a single execution; null on list results.
  """
  capabilityCounts: WorkflowExecutionCapabilityCounts
}

type WorkflowExecutionCapabilityCounts {
  total: Int!
  completed: Int!
  failed: Int!
}

enum WorkflowExecutionOrderByField {
  ID
  STATUS
  STARTED_AT
  CREDIT_USED
}

input WorkflowExecutionOrderBy {
  field: WorkflowExecutionOrderByField!
  order: SortingOrder!
}

input WorkflowExecutionsInput {
  workflowUuid: String @length(min: 1, max: 255)
  workflowExecutionIds: [String!]
    @length(min: 0, max: 50)
    @nestedLength(min: 0, max: 255)
  status: [WorkflowExecutionStatus!] @length(min: 0, max: 10)
  search: String @length(min: 1, max: 255)
  from: Time
  to: Time
  orderBy: WorkflowExecutionOrderBy
  page: Page
}

type WorkflowExecutionsOutput {
  data: [WorkflowExecution!]!
  count: Int!
}

input WorkflowExecutionInput {
  uuid: String! @length(min: 1, max: 255)
}

type WorkflowExecutionOutput {
  data: WorkflowExecution
}

input WorkflowByDeploymentIdInput {
  workflowId: WorkflowId!
}

type WorkflowByDeploymentIdOutput {
  data: WorkflowRef!
}

input WorkflowDeploymentByIdInput {
  workflowId: WorkflowId!
}

type WorkflowDeploymentByIdOutput {
