  workflowOwnerAddress: OnchainAddress!
  workflowOwnerLabel: LabelText @length(min: 1, max: 100)
  environment: Environment!
  requestProcess: LinkRequestProcess
}

input InitiateUnlinkingRequest {
  workflowOwnerAddress: OnchainAddress!
  environment: Environment!
}

input GetWorkflowResourceConsumptionFilters {
  workflowIds: [WorkflowId!] @length(min: 1, max: 10)
  workflowOwners: [OnchainAddress!] @length(min: 1, max: 10)
  workflowExecutionIds: [WorkflowId!] @length(min: 1, max: 10)
  workflowRegistryChainSelectors: [ChainSelector!] @length(min: 1, max: 2)
  resourceTypes: [ResourceTypeWithGas!] @length(min: 1, max: 10)
  fromTimestamp: Time
  toTimestamp: Time
  splitGasResourcePerChain: Boolean!
}

type WorkflowResourceConsumption {
  organizationId: OrganizationId!
  workflowId: WorkflowId!
  workflowOwner: OnchainAddress!
  workflowExecutionId: WorkflowId!
  workflowRegistryChainSelector: ChainSelector!
  resourceType: ResourceTypeWithGas!
  measurementUnit: MeasurementUnit!
  spendValue: CreditAmount!
  createdAt: Time!
}

input GetAggregatedWorkflowResourceConsumptionFilters {
  dimension: ResourceConsumptionGroupDimension!
  workflowUuids: [UUID!] @length(min: 0, max: 10)
  workflowExecutionIds: [WorkflowId!] @length(min: 0, max: 10)
  workflowRegistryChainSelectors: [ChainSelector!] @length(min: 0, max: 2)
  resourceTypes: [ResourceTypeWithGas!] @length(min: 0, max: 10)
  fromTimestamp: Time
  toTimestamp: Time
  splitGasResourcePerChain: Boolean!
}

type AggregatedSpendValue {
  resourceType: ResourceTypeWithGas!
  spendValue: CreditAmount!
}

type AggregatedWorkflowResourceConsumption {
  dimensionValue: String!
  aggregatedSpendValues: [AggregatedSpendValue!]!
}

