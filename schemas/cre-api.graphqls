}

input WorkflowOwnersFilters {
  linkStatus: LinkStatusFilter!
}

input Page {
  number: Int = 0 @size(min: 0)
  size: Int = 10 @size(min: 1, max: 100)
}

input OrganizationMemberFilters {
  memberStatus: [MemberStatus!] @length(min: 0, max: 10)
  memberType: [MemberType!] @length(min: 0, max: 10)
}

input OrganizationAccountInviteParams {
  emailAddress: Email!
  displayName: LabelText @length(min: 1, max: 100)
}

input CreateApiKeyRequest {
  expiryDate: Time!
  displayName: LabelText @length(min: 1, max: 100)
}

input UpdateApiKeyRequest {
  apiKeyId: CredentialText! @length(min: 1, max: 255)
  expiryDate: Time
  displayName: LabelText @length(min: 1, max: 100)
}

input RotateApiKeyRequest {
  apiKeyId: CredentialText! @length(min: 1, max: 255)
  expiryDate: Time
}

input OrganizationApiKeyFilters {
  apiKeyScope: OrganizationApiKeyScope
  includeExpired: Boolean
  activeStatus: [EntityActiveStatus!] @length(min: 0, max: 10)
}

input UpdateOwnerMetadataRequest {
  workflowOwnerAddress: OnchainAddress!
