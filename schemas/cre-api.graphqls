type InitiateUnlinkingResponse {
  ownershipProofHash: String!
  workflowOwnerAddress: OnchainAddress!
  validUntil: Time!
  signature: String!
  chainSelector: ChainSelector!
  contractAddress: OnchainAddress!
  transactionData: String!
  functionSignature: String!
  functionArgs: [String!]!
}

type UpdateOwnerMetadataResponse {
  success: Boolean!
}

type WorkflowActivityRow {
  from: Time!
  to: Time!
  successCount: Int!
  failureCount: Int!
}

input WorkflowActivityInput {
  workflowUUID: String @length(min: 1, max: 255)
  from: Time
  to: Time
}

